<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>Oblodai</PackageId>
    <Version>2.0.0</Version>
    <Authors>Oblodai</Authors>
    <Company>Oblodai</Company>
    <Product>Oblodai .NET SDK</Product>
    <Description>Official .NET client for the Oblodai crypto payment gateway: invoices, payouts, refunds, payout links, static wallets, webhooks and documents. Generated from the gateway's OpenAPI contract; zero third-party dependencies.</Description>
    <PackageTags>oblodai;crypto;payments;payout;cryptocurrency;usdt;webhook;payment-gateway</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/oblodai/oblodai-dotnet</PackageProjectUrl>
    <RepositoryUrl>https://github.com/oblodai/oblodai-dotnet.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <Copyright>Copyright (c) 2026 Oblodai</Copyright>
    <PackageReleaseNotes>2.0.0 — generated from the gateway's OpenAPI contract: client.Resource.MethodAsync with named arguments, decimal money, explicit per-call options, raw responses, hooks, waiters for batches and document jobs. See MIGRATION-2.0.md.</PackageReleaseNotes>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>

    <!--
      Source Link. The .NET 8 SDK ships the GitHub provider, so publishing the repository URL and
      embedding the sources git does not track is all it takes for a debugger to step into this package
      from a stack trace. ContinuousIntegrationBuild normalizes the paths baked into the PDB, which is
      what makes the package byte-identical when the same commit is built twice.
    -->
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <DebugType>portable</DebugType>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
    <None Include="../../LICENSE" Pack="true" PackagePath="/" />
    <None Include="../../AGENTS.md" Pack="true" PackagePath="/" />
  </ItemGroup>

</Project>
