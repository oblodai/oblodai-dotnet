# Credentials the SDK reads when OblodaiOptions leaves them unset.
OBLODAI_PUBLIC_ID=
OBLODAI_SECRET=
# Optional dedicated payout key pair (money-out routes).
OBLODAI_PAYOUT_PUBLIC_ID=
OBLODAI_PAYOUT_SECRET=
# Gateway origin; defaults to https://api.oblodai.com.
OBLODAI_BASE_URL=
# Admin token of a self-hosted gateway (merchant provisioning routes only).
OBLODAI_ADMIN_TOKEN=
# Allow plain http:// base URLs outside loopback.
OBLODAI_ALLOW_INSECURE=
# Console logging level: debug | info | warn | error.
OBLODAI_LOG=
# Live test target, e.g. http://127.0.0.1:8095
OBLODAI_LIVE_URL=
