# The merchant's one API key — the SDK reads these when OblodaiOptions leaves them unset.
OBLODAI_PUBLIC_ID=
OBLODAI_SECRET=
# Gateway origin; defaults to https://api.oblodai.com.
OBLODAI_BASE_URL=
# Allow plain http:// base URLs (loopback included).
OBLODAI_ALLOW_INSECURE=
# Console logging level: debug | info | warn | error.
OBLODAI_LOG=
# Live test target, e.g. http://127.0.0.1:8095
OBLODAI_LIVE_URL=
